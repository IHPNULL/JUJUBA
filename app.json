{
  "expo": {
    "name": "Jujuba",
    "slug": "jujuba",
    "scheme": "jujuba",
    "version": "1.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/39dae08b-1ea5-4f83-bd69-56b6d2dde61c",
      "checkAutomatically": "NEVER"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.jujuba",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.jujuba"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-updates"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39dae08b-1ea5-4f83-bd69-56b6d2dde61c"
      }
    },
    "owner": "ihpnull"
  }
}
